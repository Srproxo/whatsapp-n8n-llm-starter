# Copy to .env and fill in. Never commit the real file.
# Every value below is a placeholder.

# ---------------------------------------------------------------- n8n
# Encrypts credentials stored by n8n. Generate one: openssl rand -hex 24
# Keep it: if you lose it, saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public base URL of n8n, with trailing slash. Meta must reach it over HTTPS
# (use a tunnel or a reverse proxy, see docs/setup-meta.md).
# Locally you can leave http://localhost:5678/ and test with scripts/simulate.sh.
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PROTOCOL=http
GENERIC_TIMEZONE=UTC
# Keep "false" on plain http://localhost. Set to true behind HTTPS.
N8N_SECURE_COOKIE=false
# Image tag. "latest" is convenient; pin an exact version for production.
N8N_VERSION=latest

# ----------------------------------------------------- WhatsApp Cloud API
# Any string you invent. You paste the same value in Meta's webhook form.
WA_VERIFY_TOKEN=your-verify-token-here
# Meta for Developers > WhatsApp > API Setup > "Phone number ID"
WA_PHONE_NUMBER_ID=your-phone-number-id-here
# Temporary token (24 h) for testing, or a System User token for production.
WA_ACCESS_TOKEN=your-access-token-here
# Graph API version used in the send URL.
WA_GRAPH_VERSION=v21.0
# true  = do NOT call Meta; the reply is only logged (safe for local tests)
# false = send the reply through the Cloud API
WA_DRY_RUN=true

# ---------------------------------------------------------------- LLM
# Any OpenAI-compatible API. The workflow calls LLM_BASE_URL + /chat/completions
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://host.docker.internal:11434/v1  (API key can be any text)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key-here
# Model name as the provider spells it, e.g. gpt-4o-mini, llama-3.1-8b-instant, llama3.2
LLM_MODEL=your-model-name
# How many previous messages of the same number are sent to the model (0 = none).
MEMORY_MESSAGES=10

# ------------------------------------------- Owner notifications (optional)
# Used only if you enable the "Notify Owner" nodes in the workflows.
OWNER_EMAIL=owner@example.com
SMTP_FROM_EMAIL=bot@example.com
TELEGRAM_CHAT_ID=your-chat-id-here
